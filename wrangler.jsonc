{
  "name": "merit-temple",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // 每個 IP 每分鐘最多 5 首，避免 API 費用被刷
  "ratelimits": [{ "name": "RAP_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
